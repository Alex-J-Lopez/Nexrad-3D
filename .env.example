# Shared
REDIS_URL=redis://localhost:6379
REDIS_COMMAND_TIMEOUT_MS=3000

# Ingestion worker
# NOAA moved NEXRAD Level 2 data off NOMADS on 2026-09-15; use TGFTP:
NOAA_BASE_URL=https://tgftp.nws.noaa.gov/data/radar/nexrad_level2
POLL_INTERVAL_SECONDS=30
INGEST_MAX_FILES_PER_POLL=3
# Comma-separated VolumeProduct codes (REF,VEL,SW,ZDR,RHO,PHIDP). Omit for all Level-II moments.
# INGEST_PRODUCTS=REF,VEL,SW
# File parsing timeout (ms). Single timeout per file.
INGEST_FILE_TIMEOUT_MS=120000
INGEST_FETCH_TIMEOUT_MS=20000
# How many radar sites to poll/parse at once (default 4).
INGEST_SITE_CONCURRENCY=4
TIMELINE_LIMIT=240

# Object storage (MinIO) - ingest-worker uses MINIO_*
OBJECT_STORAGE_ENABLED=true
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=radar-data

# Object storage (S3) - Next.js frontend uses S3_*
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=radar-data
S3_REGION=us-east-1
