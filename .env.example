# Shared
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
REDIS_COMMAND_TIMEOUT_MS=3000

# Ingestion worker
NOAA_BASE_URL=https://nomads.ncep.noaa.gov/pub/data/nccf/radar/nexrad_level2
RADAR_SITES=KMKX,KTLX,KLOT
POLL_INTERVAL_SECONDS=30
INGEST_MAX_FILES_PER_POLL=3
# Comma-separated VolumeProduct codes (REF,VEL,SW,ZDR,RHO,PHIDP). Omit for all Level-II moments.
# INGEST_PRODUCTS=REF,VEL,SW
TIMELINE_LIMIT=240

# Object storage (MinIO)
OBJECT_STORAGE_ENABLED=true
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=radar-data

# Optional Cesium token for enhanced terrain/imagery
VITE_CESIUM_ION_TOKEN=
VITE_API_BASE_URL=http://localhost:4000
VITE_API_REQUEST_TIMEOUT_MS=10000
